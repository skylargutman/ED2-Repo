# Copy to deploy/.env on the server and fill in real values.
#   cp deploy/env.example deploy/.env
#   chmod 600 deploy/.env
#
# deploy/.env is gitignored. Never commit it.
#
# Both egnsite-web.service and egnsite-mqtt.service load this via
# EnvironmentFile=, so every value here is visible to Django as an env var.

# ---------------------------------------------------------------------------
# Django core
# ---------------------------------------------------------------------------

# Generate a NEW one -- do not reuse the key committed in settings.py, it has
# been public in git history and is therefore burned:
#   python3 -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=replace-me

DJANGO_DEBUG=False
DJANGO_SETTINGS_MODULE=EGNSite.settings

DJANGO_ALLOWED_HOSTS=sciencelabtoyou.com,www.sciencelabtoyou.com,129.153.42.213,localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=https://sciencelabtoyou.com,https://www.sciencelabtoyou.com

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# Rotate this -- 'Kings1305' from production_settings.py is in git history.
DB_NAME=egnsitedb
DB_USER=egnsite
DB_PASSWORD=replace-me
DB_HOST=127.0.0.1
DB_PORT=3306

# ---------------------------------------------------------------------------
# Redis (Channels layer)
# ---------------------------------------------------------------------------
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# ---------------------------------------------------------------------------
# MQTT
# ---------------------------------------------------------------------------
# The Django side talks to the broker over loopback; only the Pi comes in
# over the public interface.
MQTT_BROKER_HOST=127.0.0.1
MQTT_BROKER_PORT=1885
MQTT_CMD_TOPIC=pendulum/cmd
MQTT_TELEMETRY_TOPIC=raspi/to_django
