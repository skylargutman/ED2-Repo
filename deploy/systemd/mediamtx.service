# /etc/systemd/system/mediamtx.service
#
# Video relay. Ingests the camera Pi's SRT stream on :8890/udp and republishes
# it as WebRTC on :8889 (signalling, proxied by nginx) + :8189/udp (media).
#
#   sudo systemctl enable --now mediamtx

[Unit]
Description=MediaMTX video relay (SRT ingest, WebRTC egress)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=mediamtx
Group=mediamtx

# Refresh webrtcAdditionalHosts with the instance's current public IP before
# starting. The IP is ephemeral (Oracle no longer offers reserved addresses on
# this tenancy), so a rebuilt instance would otherwise advertise a stale ICE
# candidate and serve video that connects but never plays.
#
# The leading '+' runs this as root -- User=mediamtx cannot write to
# /usr/local/etc. Failure is non-fatal (leading '-'): a transient metadata
# blip should not stop the whole video relay from starting with its last
# known-good config.
ExecStartPre=-+/opt/ed2/ED2-Repo/deploy/set-public-ip.sh

ExecStart=/usr/local/bin/mediamtx /usr/local/etc/mediamtx.yml

Restart=always
RestartSec=5

# MediaMTX buffers video in RAM (hlsSegmentMaxSize/recordMaxPartSize are 50M
# each). On the 6 GB A1 this is comfortable, but the cap keeps a runaway
# muxer from touching the rest of the stack.
MemoryMax=1G

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true

[Install]
WantedBy=multi-user.target
