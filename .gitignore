# ---------------------------------------------------------------------------
# Python
# ---------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so

# Virtual environments — MUST stay untracked. The server builds its own at
# WebInterface/venv; a tracked venv makes every `git pull` on the server
# conflict, and the binaries are platform-specific anyway.
venv/
.venv/
env/

# ---------------------------------------------------------------------------
# Django
# ---------------------------------------------------------------------------
*.log
db.sqlite3
db.sqlite3-journal

# Generated by `manage.py collectstatic` — build artifact, not source.
# Source images live in WebInterface/staticfiles/.
collected_static/

# Secrets. Use deploy/env.example as the template.
.env
*.pem
*.key

# ---------------------------------------------------------------------------
# MATLAB / Simulink
# ---------------------------------------------------------------------------
slprj/
*.slxc

# ---------------------------------------------------------------------------
# KiCad
# ---------------------------------------------------------------------------
~*.lck
fp-info-cache

# Optional cleanup, NOT enabled: KiCad auto-backups (*-backups/*.zip, ~50 MB)
# and MATLAB autosaves (*.asv) are currently tracked. Uncomment and run
#   git rm -r --cached '*-backups' '*.asv' '*.kicad_prl'
# if you ever want them out. Left tracked because they were committed
# deliberately and are unrelated to the server deployment.
# *-backups/
# *.asv
# *.kicad_prl

# ---------------------------------------------------------------------------
# OS
# ---------------------------------------------------------------------------
.DS_Store
Thumbs.db
desktop.ini
