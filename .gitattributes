# Files that are authored on Windows but EXECUTED on Linux must keep LF
# endings. A shell script checked out with CRLF fails immediately with
# "bad interpreter: /usr/bin/env bash^M", and systemd silently mis-parses
# unit files whose lines end in CR.

*.sh        text eol=lf
*.service   text eol=lf
*.conf      text eol=lf
*.yml       text eol=lf
*.yaml      text eol=lf
*.py        text eol=lf

# Server-side config and docs
deploy/**   text eol=lf
docs/**     text eol=lf

# Binary assets — never touch these
*.png       binary
*.jpg       binary
*.pdf       binary
*.zip       binary
*.iso       binary
*.slx       binary
*.mdl       binary
*.pptx      binary
*.elf       binary
